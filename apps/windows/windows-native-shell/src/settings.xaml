<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <StackPanel Padding="26" Spacing="16">
    <TextBlock x:Name="c52" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
    <TextBlock Text="aBridge" FontSize="30" FontWeight="Bold" Foreground="#0066DD" Margin="0,0,0,8"/>
    <StackPanel Spacing="8">
      <TextBlock x:Name="c2" Text="正在启动…" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="c3" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="c10" MaxLength="120" AutomationProperties.Name="设备名称"/>
      <Button x:Name="c11" Content="保存名称" Grid.Column="1"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="c12" Content="暂停"/>
      <Button x:Name="c13" Content="停止当前任务"/>
      <Button x:Name="c14" Content="重新连接"/>
    </StackPanel>
    <Expander x:Name="c20" Header="连接" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="12">
        <TextBox x:Name="c21" Header="服务端网址" MaxLength="8192"/>
        <Expander Header="使用 Device Token" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <PasswordBox x:Name="c23" Header="Device Token" MaxLength="4096"/>
        </Expander>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="c24" Content="连接并授权" Style="{StaticResource AccentButtonStyle}"/>
          <Button x:Name="c25" Content="取消授权" Visibility="Collapsed"/>
          <Button x:Name="c26" Content="解绑设备"/>
        </StackPanel>
      </StackPanel>
    </Expander>
    <Expander Header="本机能力" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="100" ItemHeight="40">
        <CheckBox x:Name="c31" Content="屏幕观察" IsChecked="True"/>
        <CheckBox x:Name="c32" Content="键鼠控制" IsChecked="True"/>
        <CheckBox x:Name="c33" Content="终端" IsChecked="True"/>
        <CheckBox x:Name="c34" Content="文件" IsChecked="True"/>
      </VariableSizedWrapGrid>
    </Expander>
    <Expander Header="偏好设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="12">
        <ComboBox x:Name="c41" Header="外观" SelectedIndex="0" MinWidth="160">
          <ComboBoxItem Content="跟随系统"/>
          <ComboBoxItem Content="浅色"/>
          <ComboBoxItem Content="深色"/>
        </ComboBox>
        <TextBlock Text="暂停快捷键  Ctrl + Alt + Shift + P" FontSize="12"/>
      </StackPanel>
    </Expander>
    <Expander Header="运行诊断" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <TextBlock x:Name="c51" TextWrapping="Wrap" FontSize="12"/>
    </Expander>
    <TextBlock x:Name="c9" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"/>
  </StackPanel>
</ScrollViewer>
